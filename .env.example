# Copy to <data folder>\.env (default C:\JobSearch\data\.env). Never commit the real file.
# Gmail needs 2-Step Verification on, then create an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: send the digest somewhere other than GMAIL_ADDRESS
# DIGEST_TO=you@example.com
